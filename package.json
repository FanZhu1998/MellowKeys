{
  "name": "mellow-keys",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "node --test tests/*.test.mjs",
    "predev": "npm run build",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:start": "electron desktop/main.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "check": "npm test && npm run security:scan && npm run build",
    "export:source": "node scripts/export-source.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@vexflow-fonts/academico": "1.0.1",
    "@vexflow-fonts/bravura": "1.0.2",
    "vexflow": "5.0.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "electron": "44.4.5",
    "esbuild": "0.28.2"
  },
  "version": "1.0.0",
  "description": "An offline piano chord studio inspired by Mandopop, R&B, and Chinese-style harmony.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "main": "desktop/main.mjs",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    }
  }
}
